# Copy to .env and fill in. Never commit .env.
# Values here are defaults; most of them can also be changed on the "Налаштування" page.

# Where profiles, session files, media, DB and debug artifacts are stored (default: ./data)
# DATA_DIR=

# AI provider for text adaptation: none | openai | anthropic
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# AI assistant: OpenAI model (key above). Optional OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
ASSISTANT_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=

# Video generator: address of your local ComfyUI (Pinokio shows it on the app page)
COMFY_URL=http://127.0.0.1:8188

# Browser: msedge (default) or chrome. If not installed, bundled Chromium is used.
BROWSER_CHANNEL=msedge
# Optional path to a Chromium executable used as a fallback (e.g. on a Linux server)
# BROWSER_EXECUTABLE=

# Content inbox: data/inbox by default; can be a Google Drive / Dropbox folder
# INBOX_DIR=

# Notifications to your Telegram (or set them on the settings page)
# NOTIFY_BOT_TOKEN=
# NOTIFY_CHAT_ID=

HEADLESS=0
DRY_RUN=1
TIMEZONE=Europe/Kyiv

# Password for the web UI (HTTP Basic auth, any user name). Leave empty on your own PC;
# ALWAYS set it before running on a server that others can reach.
APP_PASSWORD=
